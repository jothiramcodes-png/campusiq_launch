# CAMPUSIQ Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campusiq_db

# Security & PII Salt
JWT_SECRET=campusiq_super_secret_jwt_key_2026
PII_SALT=nscet_theni_immutable_cryptographic_salt_2026

# AI / Vector Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Cloudinary Video & Media Cloud Hosting (Free Tier: 25GB)
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


